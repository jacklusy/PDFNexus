# === Shared ===
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000

# === Database ===
DATABASE_URL=postgresql://pdfnexus:pdfnexus@localhost:5432/pdfnexus?schema=public

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Auth / cookies ===
COOKIE_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_TTL_DAYS=60
VERIFIED_EMAIL_COOKIE=verified_email

# === Email (Google SMTP / Resend) ===
MAIL_PROVIDER=smtp
RESEND_API_KEY=
MAIL_FROM=PDFNexus <noreply@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# === Object storage (MinIO / S3) ===
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pdfnexus
S3_FORCE_PATH_STYLE=true
FILE_TTL_DAYS=7
MAX_UPLOAD_BYTES=524288000
# HMAC download links returned after upload expire after this many hours
DOWNLOAD_TOKEN_TTL_HOURS=24

# === Gemini OCR (server-only — never expose to Next.js public env) ===
GEMINI_API_KEY=
OCR_BODY_LIMIT_BYTES=6291456
OCR_MAX_BASE64_CHARS=5500000
OCR_RATE_LIMIT_WINDOW_MS=60000
OCR_RATE_LIMIT_MAX=20
OCR_MAX_CONCURRENT=2
OCR_TIMEOUT_MS=45000
OCR_DAILY_BUDGET=500

# === API ===
API_PORT=4000
TRUST_PROXY=1

# === Admin (seed once; rotate password after first login) ===
ADMIN_SESSION_SECRET=change-me-admin-session-secret-min-32-chars!!
ADMIN_SESSION_COOKIE=admin_session
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SEED_EMAIL=admin@pdfnexus.local
ADMIN_SEED_PASSWORD=Admin@PDFNexus1!
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
LOG_RETENTION_DAYS=30

# === Web (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public origin of the object storage endpoint (presigned upload/download URLs).
# Must be reachable from the browser and allowed by the CSP connect-src.
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000
