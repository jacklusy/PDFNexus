{
  "name": "pdfnexus",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev -w @pdfnexus/web",
    "dev:api": "npm run dev -w @pdfnexus/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "npm run prisma:generate -w @pdfnexus/api",
    "db:migrate": "npm run prisma:migrate -w @pdfnexus/api",
    "db:push": "npm run prisma:push -w @pdfnexus/api",
    "bundle-budget": "node scripts/bundle-budget.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@9.7.2"
}
